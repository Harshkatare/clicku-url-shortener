{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://clicku-url-shortener.onrender.com/api/:path*"
    },
    {
      "source": "/(login|register|signup|dashboard|analytics|settings|deactivated|preview)",
      "destination": "/index.html"
    },
    {
      "source": "/:slug([A-Za-z0-9_-]{3,50})",
      "destination": "https://clicku-url-shortener.onrender.com/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}