{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://clicku-url-shortener.onrender.com/api/:path*"
    },
    {
      "source": "/:shortCode([A-Za-z0-9]{6})",
      "destination": "https://clicku-url-shortener.onrender.com/:shortCode"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}