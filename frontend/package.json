{
  "name": "shortlynk-frontend",
  "private": true,
  "version": "0.4.6",
  "description": "Modern, resilient Single-Page Application (SPA) for Shortlynk built with React 19, Vite, and TypeScript. Implements TanStack Query server-state caching, React Hook Form with Zod validation, Tailwind CSS, and global ErrorBoundary crash recovery.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "keywords": [
    "react19",
    "vite",
    "typescript",
    "tanstack-query",
    "tailwind-css",
    "zod",
    "react-hook-form",
    "error-boundary",
    "spa",
    "shortlynk"
  ],
  "author": "Harsh Katare <https://github.com/Harshkatare>",
  "license": "MIT",
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^7.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
