# Server Environment Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL (Docker default: postgres:postgres@localhost:5432/shortlynk_db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shortlynk_db

# JSON Web Token Secret (Min 10 characters)
JWT_SECRET=super_secret_jwt_key_at_least_10_characters_long

# Frontend Client URL (For CORS configuration)
CLIENT_URL=http://localhost:5173
# Production example:
# CLIENT_URL=https://www.shortlynk.in

# Optional Authentication & External Integrations (Phase 5/6)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM="Shortlynk <noreply@shortlynk.in>"

# Diagnostic Token (min 16 chars; ephemeral for P0.4/P0.7; generate a random value; never commit a real token; remove after cleanup)
# DIAG_TOKEN=at_least_16_chars_token_for_diagnostics
