{
  "name": "shortlynk-backend",
  "version": "0.4.8",
  "description": "Production-grade, high-concurrency URL shortening API engineered with Express 5, TypeScript, Drizzle ORM, and PostgreSQL. Features robust DoS defenses, distributed rate limiting, structured Pino telemetry, and automated schema migrations.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "tsx -e \"process.env.NODE_ENV='production'; import('child_process').then(cp => cp.execSync('drizzle-kit migrate', { stdio: 'inherit', env: process.env }))\""
  },
  "keywords": [
    "url-shortener",
    "express5",
    "typescript",
    "drizzle-orm",
    "postgresql",
    "neon-db",
    "rate-limiting",
    "dos-mitigation",
    "structured-logging",
    "pino",
    "zod-validation",
    "jwt-authentication",
    "vitest-integration-tests",
    "clean-architecture",
    "shortlynk"
  ],
  "author": "Harsh Katare <https://github.com/Harshkatare>",
  "license": "MIT",
  "packageManager": "pnpm@10.17.0",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
